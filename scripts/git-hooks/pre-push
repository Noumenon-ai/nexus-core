#!/bin/bash
# Nexus Core hardening — tests must pass before push.
# Install via: scripts/install-git-hooks.sh
# Skip in an emergency with: git push --no-verify
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

PY=".venv/bin/python"
[ -x "$PY" ] || PY="python3"

echo "pre-push: running test suite ($PY -m pytest -q)..."
"$PY" -m pytest -q --tb=short
status=$?
if [ "$status" -ne 0 ]; then
  echo "pre-push BLOCKED: tests failed (exit $status). Fix or use --no-verify."
  exit 1
fi
echo "pre-push: tests passed."
exit 0
