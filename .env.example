# Nexus Core environment configuration.
# Copy this file to `.env` and fill in real values. Do not commit `.env`.

# === Core ===
# Telegram bot token issued by BotFather for the bot that receives all messages.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use this instance.
ALLOWED_TELEGRAM_IDS=
# IANA timezone used for all parsing, scheduling, and display formatting.
APP_TIMEZONE=UTC
# SQLAlchemy database URL. Default keeps SQLite inside the local protected `.data/` directory.
DATABASE_URL=sqlite:///./.data/nexus.db

# === LLM ===
# H2-047 Wave 2 (2026-05-13): Gemini is gone. brain_router is the single
# LLM entry point and runs `claude -p --mcp-config .mcp.json` as a local
# subprocess; the AIService + GEMINI_* + mem0ai + qdrant-client stack was
# deleted along with this file's GEMINI_* env vars. No API keys to provide.
#
# Memory archival now uses LocalMemoryService (sentence-transformers + SQLite,
# see Wave 1 of H2-046). Override the on-disk path here if you need to:
# NEXUS_LOCAL_MEMORY_DB=./.data/nexus_memory.db

# === Voice ===
# Enables Telegram voice-note intake.
VOICE_INPUT_ENABLED=true
# Voice transcription backend: local Whisper or Groq Whisper API.
VOICE_INPUT_BACKEND=whisper_local
# Whisper model size when using the local backend.
VOICE_MODEL_SIZE=base
# Maximum Telegram voice-note size accepted for transcription, in bytes.
VOICE_INPUT_MAX_FILE_BYTES=10485760
# Groq API key, only required when `VOICE_INPUT_BACKEND=groq`.
GROQ_API_KEY=
# Groq transcription model, only used when `VOICE_INPUT_BACKEND=groq`.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Enables optional synthesized voice replies.
VOICE_OUTPUT_ENABLED=true
# Voice reply backend: local Piper, OpenAI TTS, or ElevenLabs.
VOICE_OUTPUT_BACKEND=piper
# OpenAI API key used only when `VOICE_OUTPUT_BACKEND=openai_tts`.
VOICE_OPENAI_API_KEY=
# OpenAI speech model, only used when `VOICE_OUTPUT_BACKEND=openai_tts`.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OpenAI voice name, only used when `VOICE_OUTPUT_BACKEND=openai_tts`.
OPENAI_TTS_VOICE=alloy
# Optional absolute path to a Piper voice model file. Leave blank to use Piper defaults.
PIPER_MODEL_PATH=
# ElevenLabs API key for the first user by created_at order. Migration seeds this into the database once.
ELEVENLABS_API_KEY_USER_1=
# ElevenLabs voice ID for the first user by created_at order. Leave blank to fall back to Adam.
ELEVENLABS_VOICE_ID_USER_1=
# Daily ElevenLabs character quota for the first user.
ELEVENLABS_DAILY_CHAR_QUOTA_USER_1=5000
# ElevenLabs API key for the second user by created_at order.
ELEVENLABS_API_KEY_USER_2=
# ElevenLabs voice ID for the second user by created_at order. Leave blank to fall back to Adam.
ELEVENLABS_VOICE_ID_USER_2=
# Daily ElevenLabs character quota for the second user.
ELEVENLABS_DAILY_CHAR_QUOTA_USER_2=5000
# ElevenLabs model, only used when `VOICE_OUTPUT_BACKEND=elevenlabs`.
ELEVENLABS_MODEL=eleven_turbo_v2_5

# === Gmail ===
# Enables read-only Gmail scan/summarization.
GMAIL_ENABLED=false
# OAuth client credentials JSON used for gmail.readonly. Keep this under `secrets/`
# or another ignored directory, never in a tracked repo path.
GMAIL_CREDENTIALS_PATH=secrets/gmail_credentials.json
# Directory where per-user OAuth tokens are stored with mode 600/700 protections.
GMAIL_TOKEN_DIR=.data/gmail_tokens

# === Search & Opportunity Radar ===
# Master switch for read-only web search and radar scans.
WEB_SEARCH_ENABLED=true
# Search backend: DuckDuckGo HTML by default, SerpAPI when an API key is supplied.
WEB_SEARCH_BACKEND=ddg
# SerpAPI key used only when `WEB_SEARCH_BACKEND=serpapi`.
SERPAPI_KEY=
# Maximum search query length sent to the provider.
WEB_SEARCH_MAX_QUERY_CHARS=256
# Radar cadence in hours for each user's saved watch interests.
RADAR_RUN_INTERVAL_HOURS=24
# Weekly cap per opportunity category to prevent spam.
RADAR_MAX_SIGNALS_PER_CATEGORY_PER_WEEK=3
# Minimum confidence score required before surfacing an opportunity signal.
RADAR_MIN_CONFIDENCE=0.6

# === Proactive ===
# Enables morning, midday, and evening proactive loops.
PROACTIVE_ENABLED=true
# Local hour for the morning briefing.
MORNING_BRIEFING_HOUR=8
# Local hour for the midday check.
MIDDAY_CHECK_HOUR=13
# Local hour for the evening wrap.
EVENING_WRAP_HOUR=20
# Skip a recovered proactive briefing if it is later than this many hours past schedule.
BRIEFING_SKIP_IF_LATE_BY_HOURS=2

# === Approval ===
# Time-to-live for outbound-message approvals.
APPROVAL_TTL_MESSAGE_MINUTES=15
# Time-to-live for system/data-change approvals.
APPROVAL_TTL_SYSTEM_MINUTES=60
# Interval for the approval expiry sweep job.
APPROVAL_SWEEP_INTERVAL_SEC=60

# === Security ===
# Default threat model: single-user local. Use `hosted` only when you also supply SQLCipher/key-management.
THREAT_MODEL=single_user_local
# SQLCipher key used only when `THREAT_MODEL=hosted`. Hosted mode also requires
# a SQLCipher-backed DATABASE_URL such as `sqlite+pysqlcipher:///./.data/nexus.db`.
SQLCIPHER_KEY=

# === Logging ===
# Standard Python log level for the process (`DEBUG`, `INFO`, `WARNING`, `ERROR`).
LOG_LEVEL=INFO
# Comma-separated case-insensitive patterns that are redacted from log records.
LOG_REDACT_PATTERNS=api_key,token,password,Bearer

# === Google APIs (Calendar + Tasks + People — single OAuth flow per user) ===
# Master switch. When true, bootstrap validates credentials.json + token dir.
GOOGLE_INTEGRATION_ENABLED=false
# Path (relative to project root) to the Desktop OAuth client JSON downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_PATH=credentials.json
# Per-user token storage directory. Each user's refresh token is stored at <dir>/<user_id>.json (mode 600).
GOOGLE_TOKEN_DIR=.data/google_tokens
# Comma-separated OAuth scopes requested in a single consent screen.
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/tasks.readonly,https://www.googleapis.com/auth/contacts

# Browser-profile UUID mapping overrides. Leave unset to use the current local
# Nexus owner/Sam UUID defaults discovered in the live DB on 2026-05-24.
# NEXUS_USER_1_UUID=00000000-0000-0000-0000-000000000001
# NEXUS_USER_2_UUID=00000000-0000-0000-0000-000000000002

# Calendar
GOOGLE_CALENDAR_CACHE_TTL_SEC=60
GOOGLE_CALENDAR_LOOKAHEAD_DAYS=90
GOOGLE_CALENDAR_LOOKBACK_DAYS=7

# Tasks (read-only)
GOOGLE_TASKS_CACHE_TTL_SEC=120
GOOGLE_TASKS_INCLUDE_IN_BRIEFING=true

# People (Contacts)
GOOGLE_PEOPLE_CACHE_TTL_SEC=300
GOOGLE_PEOPLE_MAX_RESULTS_PER_LOOKUP=10
